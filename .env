# Copy this file to .env and fill in the values.

# --- LiveKit Cloud (free tier: ~50 minutes / month) ---
# Sign up at https://cloud.livekit.io and create a project.
# Find these on the project's Settings -> Keys page.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Google Gemini (free tier on AI Studio) ---
# Get a key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
